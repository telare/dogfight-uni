# These are examples, not credentials. The app does not load .env automatically.
# Compose reads .env for variable interpolation; local Node reads the shell environment.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
BUILD_SHA=local
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_MISSING_ORIGIN=false
MAX_CONNECTIONS_PER_IP=16
MAX_ROOMS=32
MAX_PLAYERS_PER_ROOM=32
ENABLE_DIAGNOSTICS=false
SHUTDOWN_TIMEOUT_MS=5000
LOG_DIR=logs

# Exact peer IPs allowed to supply X-Real-IP; empty for direct connections.
TRUSTED_PROXY_IPS=
