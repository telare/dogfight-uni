{
  "name": "dogfight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start": "node server/dist/index.js",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint client/src server/src shared/src",
    "format": "prettier --write client/src server/src shared/src client/index.html",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench:load": "node --conditions=development --import tsx scripts/load-test.js",
    "bench:sim": "node --conditions=development --import tsx scripts/profile-simulation.js",
    "bench:browser": "node --conditions=development --import tsx scripts/profile-browser.js",
    "bench:suite": "node --conditions=development --import tsx scripts/measure-lab07.js",
    "test:production": "node scripts/production-smoke.js",
    "bench:staging": "node scripts/staging-load.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^4.10.2",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.1.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
