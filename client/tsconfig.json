{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "shared": ["../shared/src/index.ts"],
      "shared/*": ["../shared/src/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
