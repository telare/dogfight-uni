{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "shared": ["../shared/src/index.ts"],
      "shared/*": ["../shared/src/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
